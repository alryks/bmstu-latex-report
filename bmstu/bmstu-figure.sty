% Подключения пакетов фигур
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{wrapfig}
\RequirePackage{tikzscale}

% Подключения пакета графиков
\RequirePackage{pgfplots}
\usetikzlibrary{patterns}
\pgfplotscreateplotcyclelist{bmstu monochrome bars}{%
	draw=black,pattern=north east lines,pattern color=black\\%
	draw=black,pattern=dots,pattern color=black\\%
	draw=black,pattern=crosshatch,pattern color=black\\%
	draw=black,fill=black!30\\%
}
\pgfplotsset{
	compat=newest,
	cycle list name=black white,
	colormap/blackwhite,
	bmstu bars/.style={ybar,cycle list name=bmstu monochrome bars},
}

% Команда создания рисунка
\newcommand{\includeimage}[5]
{
	\ifthenelse{\equal{#2}{f}}
	{
		\begin{figure}[#3]
			\center{\includegraphics[width=#4]{inc/img/#1}}
			\caption{#5}
			\label{img:#1}
		\end{figure}
	}
	{
		\ifthenelse{\equal{#2}{w}}
		{
			\begin{wrapfigure}{#3}{#4}
				\centering
				\includegraphics[width=\linewidth]{inc/img/#1}
				\caption{#5}
				\label{img:#1}
			\end{wrapfigure}
		}
		{
			\PackageError{bmstu}{unknown image type}{}	
		}
	}
}

% \includetexfigure{имя файла}{режим f/w}{позиция}{ширина}{подпись}[метка]
\NewDocumentCommand{\includetexfigure}{mmmmmo}{%
	\ifthenelse{\equal{#2}{f}}{%
		\begin{figure}[#3]
			\centering
			\begin{minipage}{#4}
				\centering
				\input{inc/img/#1.tex}%
			\end{minipage}
			\caption{#5}%
			\IfValueTF{#6}{\label{#6}}{\label{img:#1}}%
		\end{figure}%
	}{%
		\ifthenelse{\equal{#2}{w}}{%
			\begin{wrapfigure}{#3}{#4}
				\centering
				\input{inc/img/#1.tex}%
				\caption{#5}%
				\IfValueTF{#6}{\label{#6}}{\label{img:#1}}%
			\end{wrapfigure}%
		}{%
			\PackageError{bmstu}{unknown TeX figure type}{Use f or w.}%
		}%
	}%
}

% \includeimages{{первый,второй},{третий}}{Подпись}{имя метки}
% Каждая группа задаёт один ряд изображений из inc/img/.
\ExplSyntaxOn
\int_new:N \l__bmstu_image_panel_int
\int_new:N \l__bmstu_image_column_int
\dim_new:N \l__bmstu_image_width_dim
\dim_new:N \l__bmstu_image_height_dim

\cs_new_protected:Npn \__bmstu_image_row:n #1
  {
    \int_compare:nNnT { \clist_count:n {#1} } > {0}
      {
        \int_zero:N \l__bmstu_image_column_int
        \dim_set:Nn \l__bmstu_image_width_dim
          { 0.98\linewidth / \clist_count:n {#1} - 0.02\linewidth }
        \noindent
        \clist_map_inline:nn {#1}
          {
            \int_incr:N \l__bmstu_image_panel_int
            \int_incr:N \l__bmstu_image_column_int
            \int_compare:nNnT { \l__bmstu_image_column_int } > {1}
              { \hspace{0.02\linewidth} }
            \begin{minipage}[b]{\l__bmstu_image_width_dim}
              \centering
              \includegraphics[
                width=\linewidth,height=\l__bmstu_image_height_dim,keepaspectratio
              ]{inc/img/##1}\par
              \int_compare:nNnTF { \l__bmstu_image_panel_int } > {28}
                { \int_use:N \l__bmstu_image_panel_int }
                { \russian@alph { \int_use:N \l__bmstu_image_panel_int } })
            \end{minipage}
          }
        \par\smallskip
      }
  }

\NewDocumentCommand{\includeimages}{mmm}
  {
    \begin{figure}[htbp]
      \centering
      \int_zero:N \l__bmstu_image_panel_int
      \dim_set:Nn \l__bmstu_image_height_dim
        { \dim_min:nn {0.20\textheight} {0.48\textheight / \clist_count:n {#1}} }
      \clist_map_function:nN {#1} \__bmstu_image_row:n
      \caption{#2}
      \label{img:#3}
    \end{figure}
  }
\ExplSyntaxOff
