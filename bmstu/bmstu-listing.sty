% Настройка листингов
\RequirePackage[chapter,newfloat]{minted}
\RequirePackage{tcolorbox}
\tcbuselibrary{breakable,skins}
\RequirePackage{needspace}
\setminted{
  frame=single,
  fontsize=\footnotesize,
  style=bw,
  tabsize=4,
  breaklines=true,
  breaksymbolleft=\hfill,
  breakafter=., ,
  linenos=false,
  autogobble=true,
}

% \includelisting[параметры minted]{язык}{имя файла}{подпись}[суффикс метки]
% Метка: lst:<имя файла без расширения> или lst:<имя>-<суффикс>.
% Длинные листинги автоматически переносятся между страницами.
% \begin{listing}[параметры minted]{язык}{имя для метки}{подпись}
% Код записывается в теле окружения.
\ExplSyntaxOn
\tl_new:N \l__bmstu_listing_stem_tl
\tl_new:N \l__bmstu_listing_file_tl
\seq_new:N \l__bmstu_listing_matches_seq
\clist_const:Nn \c__bmstu_listing_extensions_clist
  { c,h,cc,cpp,cxx,hpp,cu,cuh,py,rs,go,java,kt,cs,swift,js,jsx,ts,tsx,
    sh,bash,zsh,ps1,sql,asm,s,rb,php,lua,pl,hs,lisp,lsp,cl,el,
    pro,ml,mli,fs,r,jl,html,css,xml,json,yaml,yml,toml,tex,txt }

\cs_new_protected:Npn \__bmstu_listing_find:n #1
  {
    \seq_clear:N \l__bmstu_listing_matches_seq
    \file_if_exist:nTF { inc/lst/#1 }
      { \seq_put_right:Nn \l__bmstu_listing_matches_seq { inc/lst/#1 } }
      {
        \clist_map_inline:Nn \c__bmstu_listing_extensions_clist
          {
            \file_if_exist:nT { inc/lst/#1.##1 }
              { \seq_put_right:Nn \l__bmstu_listing_matches_seq { inc/lst/#1.##1 } }
          }
      }
  }

\cs_new_protected:Npn \__bmstu_listing_file_body:nn #1#2 {
  \use:x { \exp_not:N \inputminted [\exp_not:n{#1}]
    {\exp_not:n{#2}} {\exp_not:V \l__bmstu_listing_file_tl} }
}

\cs_new_protected:Npn \__bmstu_listing_begin:nn #1#2 {
  \par\Needspace{5\baselineskip}
  % Интервал от абзаца до подписи, согласованный с longtblr.
  \addvspace{14.1pt}
  \captionsetup{hypcap=false}
  \captionof{listing}{#1}
  \label{lst:#2}
  \setminted{frame=none}
  \begin{tcolorbox}[
    blanker,breakable,geometry~nodes,
    title~after~break={Продолжение~листинга~\thelisting},
    coltitle=black,fonttitle=\normalfont,
    left=3pt,right=3pt,top=3pt,bottom=3pt,pad~at~break=3pt,
    % Компенсируем разницу между высотой строки caption и заголовка tcolorbox.
    lefttitle=0pt,righttitle=0pt,toptitle=0pt,bottomtitle=7.7pt,titlerule=0pt,
    overlay={\draw[line~width=0.4pt]
      (interior.north~west) rectangle (interior.south~east);},
    before~skip=0pt,after~skip=18.7pt,
  ]
}

\cs_new_protected:Npn \__bmstu_listing_from_file:nnnnn #1#2#3#4#5 {
  \group_begin:
  \__bmstu_listing_find:n {#3}
  \int_case:nnF { \seq_count:N \l__bmstu_listing_matches_seq }
    {
      { 0 } { \PackageError{bmstu-listing}{Listing~'#3'~not~found~in~inc/lst/}
                {Check~the~file~name~or~include~its~extension.} }
      { 1 } {
        \seq_get_left:NN \l__bmstu_listing_matches_seq \l__bmstu_listing_file_tl
        \file_parse_full_name:VNNN \l__bmstu_listing_file_tl
          \l_tmpa_tl \l__bmstu_listing_stem_tl \l_tmpb_tl
        \IfValueT{#5}{\tl_put_right:Nn \l__bmstu_listing_stem_tl {-#5}}
        \UseHook{bmstu/listing}
        \__bmstu_listing_begin:nn {#4}{\l__bmstu_listing_stem_tl}
        \__bmstu_listing_file_body:nn {#1}{#2}
        \end{tcolorbox}
      }
    }
    { \PackageError{bmstu-listing}{Multiple~files~match~listing~'#3'}
        {Include~the~file~extension~to~select~one.} }
  \group_end:
}

\NewHook{bmstu/listing}
\AddToHook{env/listing/begin}{\UseHook{bmstu/listing}}
\AddToHook{env/listing*/begin}{\UseHook{bmstu/listing}}

\NewDocumentCommand{\includelisting}{O{}mmmo}{
  \__bmstu_listing_from_file:nnnnn {#1}{#2}{#3}{#4}{#5}
}

% Вызов без фигурных аргументов сохраняет обычное окружение minted.
\cs_new_eq:NN \__bmstu_listing_float_begin: \listing
\RenewDocumentCommand{\listing}{o}{
  \peek_meaning:NTF \c_group_begin_token
    {
      \IfNoValueTF{#1}
        { \__bmstu_listing_code_begin:nnnn {} }
        { \__bmstu_listing_code_begin:nnnn {#1} }
    }
    {
      \IfNoValueTF{#1}
        { \__bmstu_listing_float_begin: }
        { \__bmstu_listing_float_begin: [#1] }
    }
}

\cs_new_protected:Npn \__bmstu_listing_code_begin:nnnn #1#2#3#4 {
  \VerbatimEnvironment
  \cs_set_eq:NN \endlisting \__bmstu_listing_code_end:
  \__bmstu_listing_begin:nn {#4}{#3}
  \begin{minted}[#1]{#2}
}

\cs_new_protected:Npn \__bmstu_listing_code_end: {
  \end{minted}
  \end{tcolorbox}
}
\ExplSyntaxOff
