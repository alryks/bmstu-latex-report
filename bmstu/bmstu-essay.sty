% Подсчет количества страниц
\RequirePackage{lastpage}
\RequirePackage{refcount}

% Подсчёт количества рисунков, таблиц и листингов
\RequirePackage{etoolbox}
\newcounter{totfigures}
\newcounter{tottables}
\newcounter{totlistings}
\AddToHook{bmstu/listing}{\stepcounter{totlistings}}
\providecommand\totfig{0}
\providecommand\tottab{0}
\providecommand\totlst{0}
\makeatletter
\AtEndDocument{%
	\addtocounter{totfigures}{\value{figure}}%
	\addtocounter{tottables}{\value{table}}%
	\immediate\write\@mainaux{%
		\string\gdef\string\totfig{\number\value{totfigures}}%
		\string\gdef\string\tottab{\number\value{tottables}}%
		\string\gdef\string\totlst{\number\value{totlistings}}%
	}%
}
\makeatother
\pretocmd{\chapter}{\addtocounter{totfigures}{\value{figure}}\setcounter{figure}{0}}{}{}
\pretocmd{\chapter}{\addtocounter{tottables}{\value{table}}\setcounter{table}{0}}{}{}

% Подсчет количества использованных источников
\newcounter{totbibentries}
\newcommand*{\listcounted}{}
\providecommand\totbib{}
\makeatletter
\AtDataInput{%
	\xifinlist{\abx@field@entrykey}\listcounted%
	{}%
	{\stepcounter{totbibentries}%
		\listxadd\listcounted{\abx@field@entrykey}}%
}%
\makeatother

% Подсчет количества приложений
\RequirePackage{totcount}
\newcounter{appendixchapters}
\regtotcounter{appendixchapters}

% Число и подходящая форма существительного, включая исключения 11--14.
\ExplSyntaxOn
\cs_new:Npn \__bmstu_essay_quantity:nnnn #1#2#3#4
  {
    \int_eval:n {#1} \nobreakspace
    \int_case:nnF { \int_mod:nn {#1} {100} }
      { {11}{#4} {12}{#4} {13}{#4} {14}{#4} }
      {
        \int_case:nnF { \int_mod:nn {#1} {10} }
          { {1}{#2} {2}{#3} {3}{#3} {4}{#3} }
          {#4}
      }
  }
\cs_new:Npn \bmstuessaysummary
  {
    \__bmstu_essay_quantity:nnnn {\getpagerefnumber{LastPage}}
      {страница}{страницы}{страниц},
    \c_space_tl
    \__bmstu_essay_quantity:nnnn {\totfig} {рисунок}{рисунка}{рисунков},
    \c_space_tl
    \__bmstu_essay_quantity:nnnn {\tottab} {таблица}{таблицы}{таблиц},
    \c_space_tl
    \__bmstu_essay_quantity:nnnn {\totlst} {листинг}{листинга}{листингов},
    \c_space_tl
    \__bmstu_essay_quantity:nnnn {\value{totbibentries}} {источник}{источника}{источников},
    \c_space_tl
    \__bmstu_essay_quantity:nnnn {\int_max:nn {0} {\totvalue{appendixchapters}}}
      {приложение}{приложения}{приложений}
  }
\ExplSyntaxOff

% Создание страницы реферата
\newenvironment{essay}[1]
{
	\chapter*{РЕФЕРАТ}
	\addcontentsline{toc}{chapter}{РЕФЕРАТ}
	
	Расчётно-пояснительная записка \bmstuessaysummary.
	
	\noindent \MakeUppercase{#1} \par
}{}
